# Copy to .env for local overrides (never commit .env)
DEBUG=True
SECRET_KEY=change-me
# ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# On Render: use Internal URL from the Postgres "Connect" menu when web + DB are in the same region.
# PASSWORD_RESET_FRONTEND_URL=https://app.example.com/reset-password
# DEFAULT_FROM_EMAIL=Aajhee <noreply@example.com>
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
# FIREBASE_CREDENTIALS_PATH=/absolute/path/to/serviceAccount.json
# Same credentials power FCM push and POST /api/auth/phone (Firebase ID token verify).
# The service account needs role "Firebase Cloud Messaging Admin" in GCP IAM.
#
# iOS APNs fallback (used when FCM send fails / is unauthorized):
# APNS_KEY_PATH=/absolute/path/to/AuthKey_XXXX.p8
# APNS_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# APNS_KEY_ID=U4ZBFCM8MN
# APNS_TEAM_ID=J5F5G7B832
# APNS_BUNDLE_ID=com.aajhee.app
# APNS_USE_SANDBOX=auto
#
# Optional Sentry (backend). Leave empty to disable.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
#
# Merchant WhatsApp via Twilio (optional). WHATSAPP_PROVIDER=twilio enables sends.
# WHATSAPP_PROVIDER=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
#
# ensure_superuser: set ADMIN_EMAIL + ADMIN_PASSWORD to create/promote.
# ADMIN_SYNC_PASSWORD=true  # only then reset password every boot for existing superuser
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
#
# Optional Gemini enrichment for admin URL product import (free tier via AI Studio).
# Without this, POST /api/admin/offers/import-from-url returns scrape-only drafts.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
#
# Persistent media (required on Render — local disk is wiped on restart).
# Works with AWS S3 or S3-compatible providers (Cloudflare R2 recommended on free tier).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=auto
# AWS_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=<public-bucket>.r2.dev
# AWS_QUERYSTRING_AUTH=False
